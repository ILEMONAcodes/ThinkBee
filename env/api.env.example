APP_ENV=local
DATABASE_URL=postgresql+asyncpg://thinkbee:thinkbee@localhost:5432/thinkbee
DATABASE_CONNECT_TIMEOUT_SECONDS=10
READINESS_TIMEOUT_SECONDS=5
REDIS_URL=redis://localhost:6379/0
ALLOWED_ORIGINS=http://localhost:3000

# Supabase Auth (service-role key is backend-only)
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_ALGORITHMS=ES256,RS256,EdDSA
SUPABASE_REQUIRED_ROLE=authenticated
SUPABASE_JWKS_CACHE_TTL_SECONDS=300
SUPABASE_JWKS_TIMEOUT_SECONDS=5
SUPABASE_JWT_LEEWAY_SECONDS=30
SUPABASE_SERVICE_ROLE_KEY=
FARMER_ID_MAX_ATTEMPTS=5
DEFAULT_LOCALE=en-NG
SUPPORTED_LOCALES=en-NG

# Farms and lists
MAX_FARMS_PER_USER=20
MAX_UNITS_PER_FARM=200
PAGE_SIZE=50
MAX_PAGE_SIZE=100

# Durable account deletion (run the ARQ worker)
SUPABASE_ADMIN_TIMEOUT_SECONDS=10
DELETION_BATCH_SIZE=25
DELETION_RETRY_SECONDS=60
DELETION_MAX_RETRY_SECONDS=3600
DELETION_JOB_TIMEOUT_SECONDS=3600

# AI
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
SCANS_PER_DAY=30
QUESTIONS_PER_DAY=60

# Storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=thinkbee
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team@macaney.example

# Chat limits
MAX_VOICE_SECONDS=180
MAX_IMAGES_PER_MESSAGE=6
MAX_IMAGE_BYTES=10485760
MAX_GROUP_MEMBERS=256
MAX_COMMUNITY_MEMBERS=5000
PUBLIC_COMMUNITIES_ENABLED=false

# Admin seed (farmer IDs, comma separated)
THINKBEE_ADMIN_FARMER_IDS=

SENTRY_DSN=
