APP_ENV=local
SECRET_KEY=change-me
DATABASE_URL=postgresql+asyncpg://thinkbee:thinkbee@localhost:5432/thinkbee
REDIS_URL=redis://localhost:6379/0
ALLOWED_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=localhost

# AI
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
SCANS_PER_DAY=30
QUESTIONS_PER_DAY=60

# SMS
SMS_PROVIDER=termii
TERMII_API_KEY=
TERMII_SENDER_ID=
OTP_PER_PHONE_PER_HOUR=5

# Storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=thinkbee
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team@macaney.example

# Chat limits
MAX_VOICE_SECONDS=180
MAX_IMAGES_PER_MESSAGE=6
MAX_IMAGE_BYTES=10485760
MAX_GROUP_MEMBERS=256
MAX_COMMUNITY_MEMBERS=5000
PUBLIC_COMMUNITIES_ENABLED=false

# Admin seed (farmer IDs, comma separated)
THINKBEE_ADMIN_FARMER_IDS=

SENTRY_DSN=
