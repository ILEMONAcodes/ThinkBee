{
  "name": "thinkbee-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run generate:api",
    "dev": "next dev",
    "prebuild": "npm run generate:api",
    "build": "next build --webpack",
    "generate:api": "openapi-typescript lib/api/openapi.json -o lib/api/schema.d.ts",
    "generate:mocks": "node scripts/generate-msw.mjs",
    "start": "next start",
    "lint": "eslint .",
    "pretypecheck": "npm run generate:api",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run generate:mocks",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:bundle": "node scripts/check-home-budget.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.90.20",
    "dexie": "^4.2.1",
    "dexie-react-hooks": "^4.2.0",
    "motion": "^13.2.0",
    "next": "16.4.3",
    "next-intl": "^4.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.71.1",
    "serwist": "^9.5.13",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@serwist/next": "^9.5.13",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "29.1.1",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.8.0",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
